{
  "name": "stamp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "snapshot": "tsx scripts/snapshot.ts",
    "agentic": "tsx scripts/agentic.ts",
    "golden:update": "UPDATE_GOLDEN=1 vitest run packages/engine/test/golden.test.ts",
    "stamp": "tsx scripts/stamp.ts",
    "probe": "tsx scripts/probe.ts",
    "replay": "tsx scripts/replay.ts",
    "serve": "tsx packages/api/src/server.ts",
    "build": "npm run build -w @stamp/web",
    "start": "tsx packages/api/src/server.ts",
    "dev:web": "npm run dev -w @stamp/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
